<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="P2_definitions" targetNamespace="https://student-lab.local/design" exporter="Student Lab design tools">
  <bpmn:collaboration id="P2_collaboration">
    <bpmn:participant id="P2_participant" name="Student Lab" processRef="P2_process" />
  </bpmn:collaboration>
  <bpmn:process id="P2_process" name="Сгенерировать набор или выборку" isExecutable="false">
    <bpmn:documentation>Descriptive model; see docs/processes.md for contracts and handled outcomes.</bpmn:documentation>
    <bpmn:startEvent id="P2_start" name="Запрос получен">
      <bpmn:outgoing>P2_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P2_prepare" name="Проверить режим, N, диапазоны и seed Зафиксировать конфигурацию генерации">
      <bpmn:incoming>P2_f1</bpmn:incoming>
      <bpmn:outgoing>P2_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P2_valid" name="Входы допустимы?" gatewayDirection="Diverging">
      <bpmn:incoming>P2_f2</bpmn:incoming>
      <bpmn:outgoing>P2_f3</bpmn:outgoing>
      <bpmn:outgoing>P2_f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P2_status" name="Исход выполнения" gatewayDirection="Diverging">
      <bpmn:incoming>P2_f8</bpmn:incoming>
      <bpmn:outgoing>P2_f10</bpmn:outgoing>
      <bpmn:outgoing>P2_f11</bpmn:outgoing>
      <bpmn:outgoing>P2_f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P2_mode" name="Выбранное действие" gatewayDirection="Diverging">
      <bpmn:incoming>P2_f3</bpmn:incoming>
      <bpmn:outgoing>P2_f4</bpmn:outgoing>
      <bpmn:outgoing>P2_f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P2_choice_merge" name="" gatewayDirection="Converging">
      <bpmn:incoming>P2_f5</bpmn:incoming>
      <bpmn:incoming>P2_f7</bpmn:incoming>
      <bpmn:outgoing>P2_f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P2_work1" name="Генерировать c и s Построить N величин с общими k и ε">
      <bpmn:incoming>P2_f4</bpmn:incoming>
      <bpmn:outgoing>P2_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P2_work2" name="Генерировать независимые Z Вычислить N чисел Стьюдента ε не применяется">
      <bpmn:incoming>P2_f6</bpmn:incoming>
      <bpmn:outgoing>P2_f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P2_success" name="Подготовить набор или выборку и параметры воспроизведения">
      <bpmn:incoming>P2_f10</bpmn:incoming>
      <bpmn:outgoing>P2_f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P2_failure" name="Подготовить ошибку без успешного результата">
      <bpmn:incoming>P2_f9</bpmn:incoming>
      <bpmn:incoming>P2_f11</bpmn:incoming>
      <bpmn:outgoing>P2_f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P2_outcome_merge" name="" gatewayDirection="Converging">
      <bpmn:incoming>P2_f12</bpmn:incoming>
      <bpmn:incoming>P2_f13</bpmn:incoming>
      <bpmn:incoming>P2_f15</bpmn:incoming>
      <bpmn:outgoing>P2_f16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P2_cancel" name="Подготовить ответ об отмене Отбросить незавершённые данные">
      <bpmn:incoming>P2_f14</bpmn:incoming>
      <bpmn:outgoing>P2_f15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P2_log" name="Записать входы, исход и значения в журнал При сбое добавить предупреждение">
      <bpmn:incoming>P2_f16</bpmn:incoming>
      <bpmn:outgoing>P2_f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P2_return" name="Вернуть ответ потребителю">
      <bpmn:incoming>P2_f17</bpmn:incoming>
      <bpmn:outgoing>P2_f18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P2_end" name="Запрос завершён">
      <bpmn:incoming>P2_f18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P2_f1" name="" sourceRef="P2_start" targetRef="P2_prepare" />
    <bpmn:sequenceFlow id="P2_f2" name="" sourceRef="P2_prepare" targetRef="P2_valid" />
    <bpmn:sequenceFlow id="P2_f3" name="да" sourceRef="P2_valid" targetRef="P2_mode" />
    <bpmn:sequenceFlow id="P2_f4" name="нечёткие величины" sourceRef="P2_mode" targetRef="P2_work1" />
    <bpmn:sequenceFlow id="P2_f5" name="" sourceRef="P2_work1" targetRef="P2_choice_merge" />
    <bpmn:sequenceFlow id="P2_f6" name="числовая выборка" sourceRef="P2_mode" targetRef="P2_work2" />
    <bpmn:sequenceFlow id="P2_f7" name="" sourceRef="P2_work2" targetRef="P2_choice_merge" />
    <bpmn:sequenceFlow id="P2_f8" name="" sourceRef="P2_choice_merge" targetRef="P2_status" />
    <bpmn:sequenceFlow id="P2_f9" name="нет" sourceRef="P2_valid" targetRef="P2_failure" />
    <bpmn:sequenceFlow id="P2_f10" name="успех" sourceRef="P2_status" targetRef="P2_success" />
    <bpmn:sequenceFlow id="P2_f11" name="ошибка" sourceRef="P2_status" targetRef="P2_failure" />
    <bpmn:sequenceFlow id="P2_f12" name="" sourceRef="P2_success" targetRef="P2_outcome_merge" />
    <bpmn:sequenceFlow id="P2_f13" name="" sourceRef="P2_failure" targetRef="P2_outcome_merge" />
    <bpmn:sequenceFlow id="P2_f14" name="отмена" sourceRef="P2_status" targetRef="P2_cancel" />
    <bpmn:sequenceFlow id="P2_f15" name="" sourceRef="P2_cancel" targetRef="P2_outcome_merge" />
    <bpmn:sequenceFlow id="P2_f16" name="" sourceRef="P2_outcome_merge" targetRef="P2_log" />
    <bpmn:sequenceFlow id="P2_f17" name="" sourceRef="P2_log" targetRef="P2_return" />
    <bpmn:sequenceFlow id="P2_f18" name="" sourceRef="P2_return" targetRef="P2_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P2_diagram">
    <bpmndi:BPMNPlane id="P2_plane" bpmnElement="P2_collaboration">
      <bpmndi:BPMNShape id="P2_participant_di" bpmnElement="P2_participant" isHorizontal="false">
        <dc:Bounds x="45" y="120" width="1510" height="1960" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_start_di" bpmnElement="P2_start">
        <dc:Bounds x="778" y="190" width="44" height="44" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="805" y="198" width="280" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_prepare_di" bpmnElement="P2_prepare">
        <dc:Bounds x="500" y="280" width="600" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_valid_di" bpmnElement="P2_valid" isMarkerVisible="true">
        <dc:Bounds x="760" y="450" width="80" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="890" y="441" width="280" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_status_di" bpmnElement="P2_status" isMarkerVisible="true">
        <dc:Bounds x="760" y="1150" width="80" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="890" y="1131" width="280" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_mode_di" bpmnElement="P2_mode" isMarkerVisible="true">
        <dc:Bounds x="760" y="610" width="80" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="890" y="591" width="280" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_choice_merge_di" bpmnElement="P2_choice_merge" isMarkerVisible="true">
        <dc:Bounds x="760" y="1010" width="80" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_work1_di" bpmnElement="P2_work1">
        <dc:Bounds x="115" y="790" width="410" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_work2_di" bpmnElement="P2_work2">
        <dc:Bounds x="1075" y="790" width="410" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_success_di" bpmnElement="P2_success">
        <dc:Bounds x="115" y="1355" width="410" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_failure_di" bpmnElement="P2_failure">
        <dc:Bounds x="1075" y="1355" width="410" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_outcome_merge_di" bpmnElement="P2_outcome_merge" isMarkerVisible="true">
        <dc:Bounds x="760" y="1545" width="80" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_cancel_di" bpmnElement="P2_cancel">
        <dc:Bounds x="595" y="1355" width="410" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_log_di" bpmnElement="P2_log">
        <dc:Bounds x="500" y="1685" width="600" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_return_di" bpmnElement="P2_return">
        <dc:Bounds x="500" y="1840" width="600" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_end_di" bpmnElement="P2_end">
        <dc:Bounds x="778" y="2010" width="44" height="44" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="820" y="2018" width="280" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P2_f1_di" bpmnElement="P2_f1">
        <di:waypoint x="800" y="234" />
        <di:waypoint x="800" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_f2_di" bpmnElement="P2_f2">
        <di:waypoint x="800" y="400" />
        <di:waypoint x="800" y="450" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_f3_di" bpmnElement="P2_f3">
        <di:waypoint x="800" y="530" />
        <di:waypoint x="800" y="610" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="675" y="551" width="320" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_f4_di" bpmnElement="P2_f4">
        <di:waypoint x="760" y="650" />
        <di:waypoint x="320" y="650" />
        <di:waypoint x="320" y="790" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="370" y="611" width="320" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_f5_di" bpmnElement="P2_f5">
        <di:waypoint x="320" y="910" />
        <di:waypoint x="320" y="1050" />
        <di:waypoint x="760" y="1050" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_f6_di" bpmnElement="P2_f6">
        <di:waypoint x="840" y="650" />
        <di:waypoint x="1280" y="650" />
        <di:waypoint x="1280" y="790" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="900" y="676" width="320" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_f7_di" bpmnElement="P2_f7">
        <di:waypoint x="1280" y="910" />
        <di:waypoint x="1280" y="1050" />
        <di:waypoint x="840" y="1050" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_f8_di" bpmnElement="P2_f8">
        <di:waypoint x="800" y="1090" />
        <di:waypoint x="800" y="1150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_f9_di" bpmnElement="P2_f9">
        <di:waypoint x="840" y="490" />
        <di:waypoint x="1530" y="490" />
        <di:waypoint x="1530" y="1415" />
        <di:waypoint x="1485" y="1415" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1270" y="451" width="320" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_f10_di" bpmnElement="P2_f10">
        <di:waypoint x="760" y="1190" />
        <di:waypoint x="320" y="1190" />
        <di:waypoint x="320" y="1355" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="380" y="1151" width="320" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_f11_di" bpmnElement="P2_f11">
        <di:waypoint x="840" y="1190" />
        <di:waypoint x="1280" y="1190" />
        <di:waypoint x="1280" y="1355" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="910" y="1211" width="320" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_f12_di" bpmnElement="P2_f12">
        <di:waypoint x="320" y="1475" />
        <di:waypoint x="320" y="1585" />
        <di:waypoint x="760" y="1585" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_f13_di" bpmnElement="P2_f13">
        <di:waypoint x="1280" y="1475" />
        <di:waypoint x="1280" y="1585" />
        <di:waypoint x="840" y="1585" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_f14_di" bpmnElement="P2_f14">
        <di:waypoint x="800" y="1230" />
        <di:waypoint x="800" y="1355" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="685" y="1276" width="320" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_f15_di" bpmnElement="P2_f15">
        <di:waypoint x="800" y="1475" />
        <di:waypoint x="800" y="1545" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_f16_di" bpmnElement="P2_f16">
        <di:waypoint x="800" y="1625" />
        <di:waypoint x="800" y="1685" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_f17_di" bpmnElement="P2_f17">
        <di:waypoint x="800" y="1805" />
        <di:waypoint x="800" y="1840" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_f18_di" bpmnElement="P2_f18">
        <di:waypoint x="800" y="1960" />
        <di:waypoint x="800" y="2010" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>