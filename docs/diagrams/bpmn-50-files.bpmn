<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="P5_definitions" targetNamespace="https://student-lab.local/design" exporter="Student Lab design tools">
  <bpmn:collaboration id="P5_collaboration">
    <bpmn:participant id="P5_participant" name="Student Lab" processRef="P5_process" />
  </bpmn:collaboration>
  <bpmn:process id="P5_process" name="Сохранить, загрузить или экспортировать" isExecutable="false">
    <bpmn:documentation>Descriptive model; see docs/processes.md for contracts and handled outcomes.</bpmn:documentation>
    <bpmn:startEvent id="P5_start" name="Запрос получен">
      <bpmn:outgoing>P5_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P5_prepare" name="Проверить действие, путь и формат Зафиксировать данные для записи">
      <bpmn:incoming>P5_f1</bpmn:incoming>
      <bpmn:outgoing>P5_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P5_valid" name="Входы допустимы?" gatewayDirection="Diverging">
      <bpmn:incoming>P5_f2</bpmn:incoming>
      <bpmn:outgoing>P5_f3</bpmn:outgoing>
      <bpmn:outgoing>P5_f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P5_status" name="Исход выполнения" gatewayDirection="Diverging">
      <bpmn:incoming>P5_f10</bpmn:incoming>
      <bpmn:outgoing>P5_f12</bpmn:outgoing>
      <bpmn:outgoing>P5_f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P5_mode" name="Выбранное действие" gatewayDirection="Diverging">
      <bpmn:incoming>P5_f3</bpmn:incoming>
      <bpmn:outgoing>P5_f4</bpmn:outgoing>
      <bpmn:outgoing>P5_f6</bpmn:outgoing>
      <bpmn:outgoing>P5_f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P5_choice_merge" name="" gatewayDirection="Converging">
      <bpmn:incoming>P5_f5</bpmn:incoming>
      <bpmn:incoming>P5_f7</bpmn:incoming>
      <bpmn:incoming>P5_f9</bpmn:incoming>
      <bpmn:outgoing>P5_f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P5_work1" name="Сериализовать эксперимент Записать временный файл Атомарно заменить целевой">
      <bpmn:incoming>P5_f4</bpmn:incoming>
      <bpmn:outgoing>P5_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P5_work2" name="Прочитать и проверить JSON Построить кандидат состояния Применить целиком">
      <bpmn:incoming>P5_f6</bpmn:incoming>
      <bpmn:outgoing>P5_f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P5_work3" name="Подготовить CSV результата Записать временный файл Атомарно заменить целевой">
      <bpmn:incoming>P5_f8</bpmn:incoming>
      <bpmn:outgoing>P5_f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P5_success" name="Подготовить подтверждение или загруженный эксперимент">
      <bpmn:incoming>P5_f12</bpmn:incoming>
      <bpmn:outgoing>P5_f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P5_failure" name="Подготовить ошибку без успешного результата">
      <bpmn:incoming>P5_f11</bpmn:incoming>
      <bpmn:incoming>P5_f13</bpmn:incoming>
      <bpmn:outgoing>P5_f15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P5_outcome_merge" name="" gatewayDirection="Converging">
      <bpmn:incoming>P5_f14</bpmn:incoming>
      <bpmn:incoming>P5_f15</bpmn:incoming>
      <bpmn:outgoing>P5_f16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P5_log" name="Записать входы, исход и значения в журнал При сбое добавить предупреждение">
      <bpmn:incoming>P5_f16</bpmn:incoming>
      <bpmn:outgoing>P5_f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P5_return" name="Вернуть ответ потребителю">
      <bpmn:incoming>P5_f17</bpmn:incoming>
      <bpmn:outgoing>P5_f18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P5_end" name="Запрос завершён">
      <bpmn:incoming>P5_f18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P5_f1" name="" sourceRef="P5_start" targetRef="P5_prepare" />
    <bpmn:sequenceFlow id="P5_f2" name="" sourceRef="P5_prepare" targetRef="P5_valid" />
    <bpmn:sequenceFlow id="P5_f3" name="да" sourceRef="P5_valid" targetRef="P5_mode" />
    <bpmn:sequenceFlow id="P5_f4" name="сохранить" sourceRef="P5_mode" targetRef="P5_work1" />
    <bpmn:sequenceFlow id="P5_f5" name="" sourceRef="P5_work1" targetRef="P5_choice_merge" />
    <bpmn:sequenceFlow id="P5_f6" name="загрузить" sourceRef="P5_mode" targetRef="P5_work2" />
    <bpmn:sequenceFlow id="P5_f7" name="" sourceRef="P5_work2" targetRef="P5_choice_merge" />
    <bpmn:sequenceFlow id="P5_f8" name="экспортировать" sourceRef="P5_mode" targetRef="P5_work3" />
    <bpmn:sequenceFlow id="P5_f9" name="" sourceRef="P5_work3" targetRef="P5_choice_merge" />
    <bpmn:sequenceFlow id="P5_f10" name="" sourceRef="P5_choice_merge" targetRef="P5_status" />
    <bpmn:sequenceFlow id="P5_f11" name="нет" sourceRef="P5_valid" targetRef="P5_failure" />
    <bpmn:sequenceFlow id="P5_f12" name="успех" sourceRef="P5_status" targetRef="P5_success" />
    <bpmn:sequenceFlow id="P5_f13" name="ошибка" sourceRef="P5_status" targetRef="P5_failure" />
    <bpmn:sequenceFlow id="P5_f14" name="" sourceRef="P5_success" targetRef="P5_outcome_merge" />
    <bpmn:sequenceFlow id="P5_f15" name="" sourceRef="P5_failure" targetRef="P5_outcome_merge" />
    <bpmn:sequenceFlow id="P5_f16" name="" sourceRef="P5_outcome_merge" targetRef="P5_log" />
    <bpmn:sequenceFlow id="P5_f17" name="" sourceRef="P5_log" targetRef="P5_return" />
    <bpmn:sequenceFlow id="P5_f18" name="" sourceRef="P5_return" targetRef="P5_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P5_diagram">
    <bpmndi:BPMNPlane id="P5_plane" bpmnElement="P5_collaboration">
      <bpmndi:BPMNShape id="P5_participant_di" bpmnElement="P5_participant" isHorizontal="false">
        <dc:Bounds x="45" y="120" width="1510" height="1960" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_start_di" bpmnElement="P5_start">
        <dc:Bounds x="778" y="190" width="44" height="44" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="805" y="198" width="280" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_prepare_di" bpmnElement="P5_prepare">
        <dc:Bounds x="500" y="280" width="600" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_valid_di" bpmnElement="P5_valid" isMarkerVisible="true">
        <dc:Bounds x="760" y="450" width="80" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="890" y="441" width="280" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_status_di" bpmnElement="P5_status" isMarkerVisible="true">
        <dc:Bounds x="760" y="1150" width="80" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="890" y="1131" width="280" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_mode_di" bpmnElement="P5_mode" isMarkerVisible="true">
        <dc:Bounds x="760" y="610" width="80" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="890" y="591" width="280" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_choice_merge_di" bpmnElement="P5_choice_merge" isMarkerVisible="true">
        <dc:Bounds x="760" y="1010" width="80" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_work1_di" bpmnElement="P5_work1">
        <dc:Bounds x="115" y="790" width="410" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_work2_di" bpmnElement="P5_work2">
        <dc:Bounds x="595" y="790" width="410" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_work3_di" bpmnElement="P5_work3">
        <dc:Bounds x="1075" y="790" width="410" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_success_di" bpmnElement="P5_success">
        <dc:Bounds x="115" y="1355" width="410" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_failure_di" bpmnElement="P5_failure">
        <dc:Bounds x="1075" y="1355" width="410" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_outcome_merge_di" bpmnElement="P5_outcome_merge" isMarkerVisible="true">
        <dc:Bounds x="760" y="1545" width="80" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_log_di" bpmnElement="P5_log">
        <dc:Bounds x="500" y="1685" width="600" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_return_di" bpmnElement="P5_return">
        <dc:Bounds x="500" y="1840" width="600" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_end_di" bpmnElement="P5_end">
        <dc:Bounds x="778" y="2010" width="44" height="44" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="820" y="2018" width="280" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P5_f1_di" bpmnElement="P5_f1">
        <di:waypoint x="800" y="234" />
        <di:waypoint x="800" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f2_di" bpmnElement="P5_f2">
        <di:waypoint x="800" y="400" />
        <di:waypoint x="800" y="450" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f3_di" bpmnElement="P5_f3">
        <di:waypoint x="800" y="530" />
        <di:waypoint x="800" y="610" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="675" y="551" width="320" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f4_di" bpmnElement="P5_f4">
        <di:waypoint x="760" y="650" />
        <di:waypoint x="320" y="650" />
        <di:waypoint x="320" y="790" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="370" y="611" width="320" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f5_di" bpmnElement="P5_f5">
        <di:waypoint x="320" y="910" />
        <di:waypoint x="320" y="1050" />
        <di:waypoint x="760" y="1050" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f6_di" bpmnElement="P5_f6">
        <di:waypoint x="800" y="690" />
        <di:waypoint x="800" y="790" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="640" y="726" width="320" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f7_di" bpmnElement="P5_f7">
        <di:waypoint x="800" y="910" />
        <di:waypoint x="800" y="1010" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f8_di" bpmnElement="P5_f8">
        <di:waypoint x="840" y="650" />
        <di:waypoint x="1280" y="650" />
        <di:waypoint x="1280" y="790" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="900" y="676" width="320" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f9_di" bpmnElement="P5_f9">
        <di:waypoint x="1280" y="910" />
        <di:waypoint x="1280" y="1050" />
        <di:waypoint x="840" y="1050" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f10_di" bpmnElement="P5_f10">
        <di:waypoint x="800" y="1090" />
        <di:waypoint x="800" y="1150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f11_di" bpmnElement="P5_f11">
        <di:waypoint x="840" y="490" />
        <di:waypoint x="1530" y="490" />
        <di:waypoint x="1530" y="1415" />
        <di:waypoint x="1485" y="1415" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1270" y="451" width="320" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f12_di" bpmnElement="P5_f12">
        <di:waypoint x="760" y="1190" />
        <di:waypoint x="320" y="1190" />
        <di:waypoint x="320" y="1355" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="380" y="1151" width="320" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f13_di" bpmnElement="P5_f13">
        <di:waypoint x="840" y="1190" />
        <di:waypoint x="1280" y="1190" />
        <di:waypoint x="1280" y="1355" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="910" y="1211" width="320" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f14_di" bpmnElement="P5_f14">
        <di:waypoint x="320" y="1475" />
        <di:waypoint x="320" y="1585" />
        <di:waypoint x="760" y="1585" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f15_di" bpmnElement="P5_f15">
        <di:waypoint x="1280" y="1475" />
        <di:waypoint x="1280" y="1585" />
        <di:waypoint x="840" y="1585" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f16_di" bpmnElement="P5_f16">
        <di:waypoint x="800" y="1625" />
        <di:waypoint x="800" y="1685" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f17_di" bpmnElement="P5_f17">
        <di:waypoint x="800" y="1805" />
        <di:waypoint x="800" y="1840" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f18_di" bpmnElement="P5_f18">
        <di:waypoint x="800" y="1960" />
